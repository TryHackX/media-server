# TryHackX Media Server — reverse proxy on the VPS, port 80.
# Generated by {{GENERATOR}} ({{GENERATED}}) for {{DOMAIN}}.
# Install as /etc/apache2/sites-available/{{SITE}}.conf  →  a2ensite {{SITE}}
#
# Port 80 does two things only: it answers Let's Encrypt (certbot --webroot)
# and sends everybody else to HTTPS. Nothing is proxied home from here, so the
# home server never sees a plain-HTTP visitor.
<VirtualHost *:80>
    ServerName {{DOMAIN}}

    Alias /.well-known/acme-challenge/ /var/www/tryhackx-media/.well-known/acme-challenge/
    <Directory /var/www/tryhackx-media/.well-known/acme-challenge/>
        Options None
        AllowOverride None
        Require all granted
    </Directory>

    RedirectMatch permanent "^/(?!\.well-known/acme-challenge/)(.*)$" "https://{{DOMAIN}}/$1"

    ErrorLog ${APACHE_LOG_DIR}/{{SITE}}-error.log
    CustomLog ${APACHE_LOG_DIR}/{{SITE}}-access.log combined
</VirtualHost>
