# TryHackX Media Server — reverse proxy on the VPS, port 443.
# Generated by {{GENERATOR}} ({{GENERATED}}) for {{DOMAIN}}.
# Install as /etc/apache2/sites-available/{{SITE}}-ssl.conf  →  a2ensite {{SITE}}-ssl
# Enable it only AFTER certbot has issued the certificate: Apache refuses to
# start with an SSLCertificateFile that does not exist yet.
#
# Required modules: a2enmod proxy proxy_http ssl headers
<VirtualHost *:443>
    ServerName {{DOMAIN}}

    SSLEngine on
    SSLCertificateFile    /etc/letsencrypt/live/{{DOMAIN}}/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/{{DOMAIN}}/privkey.pem

    # HSTS belongs to the host that terminates the visitor's TLS — this one.
    Header always set Strict-Transport-Security "max-age=31536000"

    # ---- The page shown while the home server does not answer ----------------
    # Served from this machine, never proxied. Only errors produced HERE (the
    # home server is off, unreachable or too slow) are replaced by it.
    # ProxyErrorOverride is deliberately not used: it would also replace the
    # application's own error answers (JSON with 4xx/503), and the interface
    # reads those.
    Alias /maintenance.html /var/www/tryhackx-media/maintenance.html
    <Directory /var/www/tryhackx-media>
        Options None
        AllowOverride None
        Require all granted
    </Directory>
    ErrorDocument 502 /maintenance.html
    ErrorDocument 503 /maintenance.html
    ErrorDocument 504 /maintenance.html

    # ---- The connection home ---------------------------------------------------
    # The home server presents one long-lived self-signed certificate, and this
    # proxy accepts exactly that certificate and no other: origin.crt is the only
    # trust anchor. The name check is off because the backend is addressed by its
    # IP address and the certificate, on purpose, names nobody.
    SSLProxyEngine On
    SSLProxyVerify require
    SSLProxyVerifyDepth 1
    SSLProxyCACertificateFile /etc/apache2/tryhackx-media/origin.crt
    SSLProxyCheckPeerName off
    SSLProxyCheckPeerCN off
    SSLProxyCheckPeerExpire on
    SSLProxyProtocol all -SSLv3 -TLSv1 -TLSv1.1

    ProxyRequests Off
    # The home server must see the public name, or it would build redirects
    # from its own.
    ProxyPreserveHost On

    # Who the visitor is and how they came. Both headers are SET, never
    # appended: whatever the client sent under these names is discarded here.
    # ProxyAddHeaders Off stops mod_proxy from appending a second copy.
    ProxyAddHeaders Off
    RequestHeader set X-Forwarded-For "expr=%{REMOTE_ADDR}"
    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader unset Forwarded
    RequestHeader unset X-Forwarded-Host
    RequestHeader unset X-Real-IP

    # Ordinary pages and API calls: a minute covers a slow first answer (the
    # compatibility stream starts FFmpeg before the first byte arrives).
    ProxyTimeout 60

    ProxyPass /maintenance.html !
    # Films, downloads and ZIP archives are single long requests. The timeout
    # counts silence between packets, not the length of the transfer; an hour
    # matches the home server's own setting. `nocanon` passes the signed token in
    # the path through untouched. This line must stay ABOVE the catch-all.
    ProxyPass /media-transfer/ https://{{HOME_TARGET}}/media-transfer/ connectiontimeout=5 timeout=3600 retry=0 nocanon
    ProxyPass / https://{{HOME_TARGET}}/ connectiontimeout=5 timeout=60 retry=0
    ProxyPassReverse / https://{{HOME_TARGET}}/

    ErrorLog ${APACHE_LOG_DIR}/{{SITE}}-error.log
    CustomLog ${APACHE_LOG_DIR}/{{SITE}}-access.log combined
</VirtualHost>
